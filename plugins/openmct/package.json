{
  "name": "@caelum/openmct-plugin",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "description": "CAELUM Open MCT plugin: OPS-channel telemetry provider, crew status board and alert timeline (F-GND-04)",
